# Настройки ZTE F680 — скопируй в .env и заполни:  cp .env.example .env
#
# Приоритет: переменные окружения > .env > значения по умолчанию.
# Все три переменные опциональны; без F680_PASSWORD скрипты не работают.

# IP/адрес роутера (по умолчанию http://192.168.1.1)
F680_BASE=http://192.168.1.1

# Логин (роль user-level; по умолчанию mgts)
F680_USERNAME=mgts

# Пароль (обязательно, сюда свой)
F680_PASSWORD=
